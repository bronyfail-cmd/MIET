{
  "id": "temperament",
  "title": "Структура темперамента",
  "kind": "scale",
  "demo": false,
  "scale": {
    "min": 1,
    "max": 5,
    "labels": {
      "1": "не выражена",
      "2": "скорее не выражена",
      "3": "выражена",
      "4": "заметно выражена",
      "5": "очень выражена"
    }
  },
  "subscales": {
    "erm": "Эргичность психомоторная",
    "eri": "Эргичность интеллектуальная",
    "erk": "Эргичность коммуникативная",
    "pm": "Пластичность психомоторная",
    "pi": "Пластичность интеллектуальная",
    "pk": "Пластичность коммуникативная",
    "sm": "Скорость психомоторная",
    "si": "Скорость интеллектуальная",
    "sk": "Скорость коммуникативная",
    "em": "Эмоциональность психомоторная",
    "ei": "Эмоциональность интеллектуальная",
    "ek": "Эмоциональность коммуникативная",
    "ksh": "Контрольная шкала"
  },
  "questions": [
    {
      "n": 1,
      "text": "Я охотно выполняю физическую работу",
      "subscale": "erm",
      "reverse": false
    },
    {
      "n": 2,
      "text": "Я с удовольствием решаю задачи сверх того, что было задано учителем",
      "subscale": "eri",
      "reverse": false
    },
    {
      "n": 3,
      "text": "Мне нравится бывать в больших компаниях",
      "subscale": "erk",
      "reverse": false
    },
    {
      "n": 4,
      "text": "Мне нравится мастерить вещи своими руками (заниматься рукоделием)",
      "subscale": "pm",
      "reverse": false
    },
    {
      "n": 5,
      "text": "Мне было бы легко выполнить несколько контрольных работ по разным предметам в один день",
      "subscale": "pi",
      "reverse": false
    },
    {
      "n": 6,
      "text": "Мне легко завязывать знакомства первым",
      "subscale": "pk",
      "reverse": false
    },
    {
      "n": 7,
      "text": "Я люблю участвовать в спортивных играх, требующих быстрых движений",
      "subscale": "sm",
      "reverse": false
    },
    {
      "n": 8,
      "text": "Я быстро решаю арифметические задачи",
      "subscale": "si",
      "reverse": false
    },
    {
      "n": 9,
      "text": "Мне легко говорить быстро",
      "subscale": "sk",
      "reverse": false
    },
    {
      "n": 10,
      "text": "Занимаясь ремеслом (рукоделием), я раздражаюсь, когда работа не ладится",
      "subscale": "em",
      "reverse": false
    },
    {
      "n": 11,
      "text": "Я сильно волнуюсь перед предстоящей контрольной работой",
      "subscale": "ei",
      "reverse": false
    },
    {
      "n": 12,
      "text": "Я испытываю чувство обиды, когда окружающие меня люди обходятся со мной хуже, чем следовало бы",
      "subscale": "ek",
      "reverse": false
    },
    {
      "n": 13,
      "text": "Бывает, что я говорю о вещах, в которых не разбираюсь",
      "subscale": "ksh",
      "reverse": false
    },
    {
      "n": 14,
      "text": "Мне легко заниматься физическим трудом длительное время",
      "subscale": "erm",
      "reverse": false
    },
    {
      "n": 15,
      "text": "Я предпочитаю задания, требующие большой умственной нагрузки",
      "subscale": "eri",
      "reverse": false
    },
    {
      "n": 16,
      "text": "Я предпочитаю постоянно находиться среди друзей",
      "subscale": "erk",
      "reverse": false
    },
    {
      "n": 17,
      "text": "Я легко обучаюсь ремеслу (рукоделию)",
      "subscale": "pm",
      "reverse": false
    },
    {
      "n": 18,
      "text": "Мне легко учиться по основным предметам и еще посещать различные кружки",
      "subscale": "pi",
      "reverse": false
    },
    {
      "n": 19,
      "text": "При встрече я обычно начинаю разговор первым",
      "subscale": "pk",
      "reverse": false
    },
    {
      "n": 20,
      "text": "Мне нравятся игры, требующие быстроты и ловкости движений",
      "subscale": "sm",
      "reverse": false
    },
    {
      "n": 21,
      "text": "Я способен быстро принимать решения, находясь в любой ситуации",
      "subscale": "si",
      "reverse": false
    },
    {
      "n": 22,
      "text": "Я разговорчивый человек",
      "subscale": "sk",
      "reverse": false
    },
    {
      "n": 23,
      "text": "Я огорчаюсь из-за того, что с трудом овладеваю ремеслом (рукоделием)",
      "subscale": "em",
      "reverse": false
    },
    {
      "n": 24,
      "text": "Я сильно переживаю, если сдал экзамен менее успешно, чем ожидал",
      "subscale": "ei",
      "reverse": false
    },
    {
      "n": 25,
      "text": "Я сильно волнуюсь, когда мне приходится выяснять отношения с друзьями",
      "subscale": "ek",
      "reverse": false
    },
    {
      "n": 26,
      "text": "Я никогда не сплетничаю",
      "subscale": "ksh",
      "reverse": false
    }
  ],
  "levels": [
    {
      "upto": 0.4,
