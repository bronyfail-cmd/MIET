      "reverse": false
    },
    {
      "n": 20,
      "text": "Я смотрю телевизор или погружаюсь в интернет, чтобы меньше думать о проблеме",
      "subscale": "ment_escape",
      "reverse": false
    },
    {
      "n": 21,
      "text": "Я стараюсь принять ситуацию, сжиться с ней",
      "subscale": "acceptance",
      "reverse": false
    },
    {
      "n": 22,
      "text": "Я переживаю и активно проявляю свои чувства",
      "subscale": "emot_expr",
      "reverse": false
    },
    {
      "n": 23,
      "text": "Я предпринимаю активные действия, чтобы справиться с проблемой",
      "subscale": "active_cope",
      "reverse": false
