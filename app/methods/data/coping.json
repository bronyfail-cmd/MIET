  "questions": [
    {
      "n": 1,
      "text": "Я надеюсь на то, что Бог мне поможет",
      "subscale": "religion",
      "reverse": false
    },
    {
      "n": 2,
      "text": "Я стараюсь удерживать себя от скоропалительных шагов",
