      "reverse": false
    },
    {
      "n": 10,
      "text": "Я даю выход своим переживаниям",
      "subscale": "emot_expr",
      "reverse": false
    },
    {
      "n": 11,
      "text": "Я пытаюсь посмотреть на ситуацию с более позитивной стороны, в ином свете",
      "subscale": "pos_reform",
      "reverse": false
    },
    {
      "n": 12,
      "text": "Я говорю с кем-нибудь, кто мог бы конкретно помочь решить мою проблему",
      "subscale": "instr_support",
      "reverse": false
