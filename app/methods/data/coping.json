    {
      "n": 24,
      "text": "Я снижаю количество усилий, направленных на решение этой проблемы",
      "subscale": "beh_escape",
      "reverse": false
    },
    {
      "n": 25,
      "text": "Я обсуждаю свои переживания с кем-то из моих близких",
      "subscale": "emot_support",
      "reverse": false
    },
    {
      "n": 26,
      "text": "Я принимаю успокоительные, потому что это помогает мне преодолеть проблему",
      "subscale": "sedatives",
      "reverse": false
    },
    {
      "n": 27,
      "text": "Я учусь жить с этим",
      "subscale": "acceptance",
      "reverse": false
    },
    {
      "n": 28,
      "text": "Я откладываю другие дела в сторону, чтобы сосредоточиться на решении проблемы",
      "subscale": "suppress_comp",
      "reverse": false
    },
    {
      "n": 29,
      "text": "Я тщательно обдумываю шаги, которые буду предпринимать для решения проблемы",
      "subscale": "planning",
      "reverse": false
    },
    {
      "n": 30,
      "text": "Я просто делаю вид, что ничего не случилось",
      "subscale": "denial",
      "reverse": false
    }
