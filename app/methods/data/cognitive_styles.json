{
  "id": "cognitive_styles",
  "title": "Когнитивные стили",
  "kind": "scale",
  "demo": false,
  "scale": {
    "min": 1,
    "max": 5,
    "labels": {
      "1": "не выражена",
      "2": "скорее не выражена",
      "3": "выражена",
      "4": "заметно выражена",
      "5": "очень выражена"
    }
  },
  "subscales": {
    "field_dep": "Полезависимость",
    "field_ind": "Поленезависимость",
    "narrow_eq": "Узкий диапазон эквивалентности",
    "wide_eq": "Широкий диапазон эквивалентности",
    "flex_ctrl": "Гибкость познавательного контроля",
    "rigid_ctrl": "Ригидность познавательного контроля",
    "impuls": "Импульсивность",
    "refl": "Рефлективность",
    "concr": "Конкретная концептуализация",
    "abstr": "Абстрактная концептуализация",
    "toler": "Толерантность к нереалистическому опыту",
    "intoler": "Нетолерантность к нереалистическому опыту"
  },
  "questions": [
    {
      "n": 1,
      "text": "Покупая одежду, я доверяю мнению продавца",
      "subscale": "field_dep",
      "reverse": false
    },
    {
      "n": 2,
      "text": "Я часто принимаю решения по первому впечатлению",
      "subscale": "impuls",
      "reverse": false
    },
    {
      "n": 3,
      "text": "Я всегда принимаю решения самостоятельно",
      "subscale": "field_ind",
      "reverse": false
    },
    {
      "n": 4,
      "text": "Я не люблю вдаваться в подробности, пересказывая события",
      "subscale": "wide_eq",
      "reverse": false
    },
    {
      "n": 5,
      "text": "Я одинаково хорошо запоминаю как картинки, так и тексты",
      "subscale": "flex_ctrl",
      "reverse": false
    },
    {
      "n": 6,
      "text": "Я готов решать любую задачу не задумываясь",
      "subscale": "impuls",
      "reverse": false
    },
    {
      "n": 7,
      "text": "Мой собственный опыт для меня важнее, чем мнение друзей",
      "subscale": "field_ind",
      "reverse": false
    },
    {
      "n": 8,
      "text": "Я легко делю людей на хороших и плохих",
      "subscale": "wide_eq",
      "reverse": false
    },
    {
      "n": 9,
      "text": "Люди, которые думают не так, как я, меня сильно раздражают",
      "subscale": "intoler",
      "reverse": false
    },
    {
      "n": 10,
      "text": "Я легко соглашаюсь с мнением друзей",
      "subscale": "field_dep",
      "reverse": false
    },
    {
      "n": 11,
      "text": "Мне легко одновременно беседовать и смотреть телевизор",
      "subscale": "flex_ctrl",
      "reverse": false
    },
    {
      "n": 12,
      "text": "Мне трудно описывать словами абстрактные картинки",
      "subscale": "rigid_ctrl",
      "reverse": false
    },
    {
      "n": 13,
      "text": "Я люблю получать дополнительную информацию из справочников",
      "subscale": "toler",
      "reverse": false
    },
    {
      "n": 14,
      "text": "Я приступаю к решению задачи после ее тщательного обдумывания",
      "subscale": "refl",
      "reverse": false
    },
    {
      "n": 15,
      "text": "Я всегда открыт к новой информации и новому опыту",
      "subscale": "abstr",
      "reverse": false
    },
    {
      "n": 16,
      "text": "Пересказывая содержание фильма, я люблю подробно его описать",
      "subscale": "narrow_eq",
      "reverse": false
    },
    {
      "n": 17,
      "text": "Меня привлекает оригинальность суждений других людей",
      "subscale": "toler",
      "reverse": false
    },
    {
      "n": 18,
      "text": "Я общаюсь только с теми людьми, мировоззрение которых совпадает с моим",
      "subscale": "intoler",
      "reverse": false
    },
    {
      "n": 19,
      "text": "Я хорошо помню детали моего последнего дня рождения",
      "subscale": "narrow_eq",
      "reverse": false
    },
    {
      "n": 20,
      "text": "Мне трудно подобрать образ к абстрактным словам",
      "subscale": "rigid_ctrl",
      "reverse": false
    },
    {
      "n": 21,
      "text": "Я человек конкретный и не люблю рассуждать: вот если бы",
      "subscale": "concr",
      "reverse": false
    },
    {
      "n": 22,
      "text": "Перед принятием решения я тщательно перепроверяю все факты",
      "subscale": "refl",
      "reverse": false
    },
    {
      "n": 23,
      "text": "Я предпочитаю задания, к которым прилагаются четкие инструкции",
      "subscale": "concr",
      "reverse": false
    },
    {
      "n": 24,
      "text": "В сложных задачах я предлагаю несколько вариантов решений",
      "subscale": "abstr",
      "reverse": false
    }
  ],
  "levels": [
    {
      "upto": 0.4,
      "name": "низкий",
      "text": "Низкий уровень показателя"
    },
    {
      "upto": 0.7,
      "name": "средний",
      "text": "Средний уровень показателя"
    },
    {
      "upto": 1.0,
      "name": "высокий",
      "text": "Высокий уровень показателя"
    }
  ]
