  "questions": [
    {
      "n": 1,
      "text": "Я заражаю людей оптимизмом",
      "subscale": "hyper",
      "reverse": false
    },
    {
      "n": 2,
      "text": "Я легко занимаюсь организаторской деятельностью",
      "subscale": "hyper",
      "reverse": false
    },
    {
      "n": 3,
      "text": "Я с трудом забываю нанесенные мне незначительные обиды",
      "subscale": "stuck",
      "reverse": false
    },
    {
      "n": 4,
      "text": "Оскорбления, нанесенные мне, вызывают у меня скрытую ярость",
      "subscale": "stuck",
      "reverse": false
    },
    {
      "n": 5,
      "text": "Я чувствительный, мягкосердечный человек",
      "subscale": "emot",
      "reverse": false
    },
    {
      "n": 6,
      "text": "Трагические фильмы могут взволновать меня до слез",
      "subscale": "emot",
      "reverse": false
    },
    {
      "n": 7,
      "text": "Я слежу за тем, чтобы каждая вещь лежала на своем месте",
      "subscale": "pedant",
      "reverse": false
    },
    {
      "n": 8,
      "text": "Я стремлюсь навести порядок везде и во всем",
      "subscale": "pedant",
      "reverse": false
    },
    {
      "n": 9,
      "text": "Я боюсь спуститься в темный погреб",
      "subscale": "trevo",
      "reverse": false
    },
    {
      "n": 10,
      "text": "Я боязливый человек",
      "subscale": "trevo",
      "reverse": false
    },
    {
      "n": 11,
      "text": "У меня бывают беспричинные колебания настроения",
      "subscale": "cycl",
      "reverse": false
    },
    {
      "n": 12,
      "text": "Период хорошего настроения у меня может смениться апатией",
      "subscale": "cycl",
      "reverse": false
    },
    {
      "n": 13,
      "text": "Я постоянно стремлюсь быть в центре внимания",
      "subscale": "demo",
      "reverse": false
    },
    {
      "n": 14,
      "text": "Я прекрасно чувствую себя на сцене",
      "subscale": "demo",
      "reverse": false
    },
    {
      "n": 15,
      "text": "Я готов ударить человека, если он меня сильно оскорбил",
      "subscale": "vozb",
      "reverse": false
    },
    {
      "n": 16,
      "text": "Когда меня задевают за больное, я могу ударить",
      "subscale": "vozb",
      "reverse": false
    },
    {
      "n": 17,
      "text": "Я замкнутый, немногословный человек",
      "subscale": "dist",
      "reverse": false
    },
    {
      "n": 18,
      "text": "Я долгое время могу быть в подавленном настроении",
      "subscale": "dist",
      "reverse": false
    },
    {
      "n": 19,
      "text": "Мое радостное настроение резко сменяется глубокой печалью",
      "subscale": "exalt",
      "reverse": false
    },
    {
      "n": 20,
      "text": "Я подвержен частым перепадам настроения - от радости к печали",
      "subscale": "exalt",
      "reverse": false
    }
